# SmartShop POS — Desktop Client Environment Configuration Example

# Language Mode: 'bilingual' | 'si' | 'en'
VITE_DEFAULT_LANGUAGE=bilingual

# Business Vertical: 'all_goods' | 'smart_items' | 'mobile_shop' | 'electronics' | 'grocery'
VITE_BUSINESS_TYPE=all_goods

# Store Branding
VITE_STORE_NAME="SMARTSHOP TECH & ALL GOODS"
VITE_STORE_NAME_SI="ස්මාර්ට්ෂොප් තාක්ෂණික සහ සියලුම භාණ්ඩ"

# Backend API Endpoint
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# UUID of an active device registered to this cashier's store in Filament.
# Set this for each desktop terminal before building or starting Vite.
VITE_DEVICE_UUID=
